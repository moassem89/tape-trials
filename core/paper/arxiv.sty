% arxiv.sty — self-contained arXiv-preprint style for Primus s7 papers.
% Single-column preprint look using only packages that ship with TeX Live.
% No external downloads required. Load with \usepackage{arxiv}.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2026/06/01 v1.0 Primus arXiv-preprint style]

% --- page geometry: roomy single column, preprint margins -----------------
\RequirePackage[letterpaper,margin=1in,headheight=14pt]{geometry}

% --- typography -----------------------------------------------------------
\RequirePackage{microtype}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\renewcommand{\baselinestretch}{1.05}

% --- math, tables, graphics, color ----------------------------------------
\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{tikz}

% --- section headings: bold, slightly larger ------------------------------
\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{1em}{}

% --- running header with short title --------------------------------------
\RequirePackage{fancyhdr}
\newcommand{\@runningtitle}{}
\newcommand{\runningtitle}[1]{\renewcommand{\@runningtitle}{#1}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\small\itshape\@runningtitle}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}

% --- abstract: indented, ruled block --------------------------------------
\renewenvironment{abstract}{%
  \begin{center}\bfseries Abstract\end{center}%
  \vspace{-0.5em}\begin{quote}\small}{\end{quote}\vspace{0.5em}}

% --- citations (numeric natbib; use \citep / \citet, load before hyperref) -
\RequirePackage[numbers]{natbib}

% --- hyperlinks (load late) -----------------------------------------------
\RequirePackage[colorlinks=true,linkcolor=blue!50!black,citecolor=blue!50!black,urlcolor=blue!50!black]{hyperref}
\RequirePackage{url}

% --- provenance watermark (REQUIRED — do not remove) -----------------------
% Every paper produced by this project is machine-generated and must not be
% submitted anywhere. A light-grey watermark runs vertically up the LEFT MARGIN
% of every page, clear of the text block. Loading arxiv.sty is enough; no call
% is needed in paper.tex. eso-pic ships with a standard TeX Live and is fetched
% automatically by tectonic.
\RequirePackage{eso-pic}   % \rotatebox comes from graphicx, loaded above
\definecolor{tlwatermark}{gray}{0.85}
\newcommand{\watermarktext}{GENERATED BY TRANSFORMER LAB -- SUBMISSION PROHIBITED}
% Rotated 90 degrees (reads bottom-to-top), centred on the left margin band and
% scaled to 0.8\textheight so it fits any paper size or text length.
% \tlwmx = horizontal centre of the left margin = (1in + \oddsidemargin) / 2.
\newlength{\tlwmx}
\setlength{\tlwmx}{\oddsidemargin}
\addtolength{\tlwmx}{1in}
\setlength{\tlwmx}{0.5\tlwmx}
\AddToShipoutPictureBG{%
  \AtPageLowerLeft{%
    \put(\LenToUnit{\tlwmx},\LenToUnit{0.5\paperheight}){%
      \makebox(0,0){%
        \rotatebox{90}{%
          \resizebox{0.8\textheight}{!}{%
            \textcolor{tlwatermark}{\sffamily\bfseries\watermarktext}}}}}}}

\endinput
